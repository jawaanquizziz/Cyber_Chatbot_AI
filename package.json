{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "vite",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "tsc && vite build && node -e \"const fs=require('fs'); fs.cpSync('dist', 'frontend/dist', {recursive: true});\"",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "react-router-dom": "^7.18.4"
  }
}
